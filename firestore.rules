rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---
    // Using broad permissions for prototype development to ensure all operations reflect immediately.

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /machineTypes/{typeId} {
      allow read, write: if isSignedIn();
    }

    match /lines/{lineId} {
      allow read, write: if isSignedIn();
    }

    match /machines/{machineId} {
      allow read, write: if isSignedIn();
    }

    match /transfers/{transferId} {
      allow read, write: if isSignedIn();
    }

    match /maintenanceTasks/{taskId} {
      allow read, write: if isSignedIn();
    }
  }
}